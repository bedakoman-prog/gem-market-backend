# --- Base de données ---
DATABASE_URL="postgresql://gem:gem@localhost:5432/gem_market?schema=public"

# --- Redis (sessions, rate limiting, files d'attente webhooks) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# --- OTP (SMS) ---
# En dev, OTP_PROVIDER=console affiche le code dans les logs au lieu d'envoyer un vrai SMS.
OTP_PROVIDER="console"
OTP_CODE_TTL_SECONDS="300"

# --- CinetPay (sandbox) ---
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com/v2"
CINETPAY_TRANSFER_BASE_URL="https://client.cinetpay.com/v1"
CINETPAY_TRANSFER_LOGIN=""
CINETPAY_TRANSFER_PASSWORD=""

# --- PayDunya (sandbox) ---
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_BASE_URL="https://app.paydunya.com/api/v1"
PAYDUNYA_MODE="test"

# Prestataire utilisé par défaut pour un nouvel encaissement ("cinetpay" ou "paydunya").
PAYMENT_DEFAULT_PROVIDER="cinetpay"

# --- Stockage photos/vidéos (section 2 : ne doit pas rester sur le serveur d'appli) ---
# "local" écrit dans ./uploads et sert via /media/* — développement UNIQUEMENT.
# "s3" envoie vers un vrai bucket compatible S3 (AWS S3, Backblaze B2, OVH Object Storage...).
STORAGE_DRIVER="local"
PUBLIC_BASE_URL="http://localhost:3000"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="eu-west-1"
STORAGE_S3_ENDPOINT=""                 # laisser vide pour AWS S3 ; renseigner pour Backblaze/OVH
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_PUBLIC_BASE_URL=""          # ex. URL CDN devant le bucket, si configurée
MEDIA_MAX_IMAGE_MB="8"
MEDIA_MAX_VIDEO_MB="50"

# --- Plateforme ---
PLATFORM_COMMISSION_RATE="0.01"
SHOP_PRICE_PER_DAY_USD="1"
SHOP_MAX_LISTINGS="10"
ORDER_AUTO_RELEASE_HOURS="72"

# --- Période promotionnelle de lancement (PromoPeriodService) ---
# Décision produit : les vendeurs publient gratuitement leurs annonces
# bien/service/emploi (pas d'abonnement Boutique requis) pendant les premiers
# mois suivant le lancement, alors que le séquestre des paiements (commandes)
# démarre normalement dès le lancement — ce sont deux mécanismes distincts.
# Laisser LAUNCH_DATE vide tant que le lancement réel n'a pas eu lieu : la
# promo reste inactive et le comportement actuel (abonnement requis) ne
# change pas pendant la phase de tests. Le jour du lancement, renseigner
# LAUNCH_DATE une seule fois ; la bascule gratuit -> payant se fait ensuite
# automatiquement à l'échéance, sans action manuelle.
LAUNCH_DATE=""                       # ex. "2026-10-01" — date ISO du lancement réel
PROMO_FREE_LISTING_MONTHS="4"        # durée de la gratuité (fourchette produit : 3 à 6 mois)

PORT=3000
NODE_ENV="development"
